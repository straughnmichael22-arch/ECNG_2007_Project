      "remediation": {
        "downloadUrl": "https://www.amd.com/en/support/downloads/adaptive-socs-and-fpgas/development-tools/2026-1.html",
        "instructions": [
          "Open the official AMD download page.",
          "Locate the approved Vivado version.",
          "Locate and select the AMD Unified Installer for Windows Self Extracting Web Installer.",
          "Sign in to your AMD account or create one if prompted.",
