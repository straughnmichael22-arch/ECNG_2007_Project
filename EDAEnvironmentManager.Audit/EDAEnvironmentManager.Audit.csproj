<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The environment audit without any user interface, so that the P3A window and the
    P3B remediation dashboard run exactly the same checks.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EDAEnvironmentManager.Audit</RootNamespace>
  </PropertyGroup>

</Project>
