      "maximumApprovedVersion": "6.0.0",
      "expectedPaths": [
        "%USERPROFILE%\\Downloads\\ghdl-*\\bin\\ghdl.exe",
        "%USERPROFILE%\\Downloads\\bin\\ghdl.exe",
        "%USERPROFILE%\\Desktop\\ghdl-*\\bin\\ghdl.exe",
        "%USERPROFILE%\\Desktop\\bin\\ghdl.exe",
        "%USERPROFILE%\\Documents\\ghdl-*\\bin\\ghdl.exe",
        "%USERPROFILE%\\Documents\\bin\\ghdl.exe"
      ],
      "searchRoots": [],
      "relativeExecutablePath": "",
      "versionArguments": "--version",
      "smokeTest": {
        "enabled": true,
        "method": "analyze-elaborate-run",
        "testFile": "hello.vhd",
        "entity": "hello",
        "standard": "08",
        "source": "entity hello is\nend entity hello;\n\narchitecture test of hello is\nbegin\n    process\n    begin\n        report \"GHDL simulation works!\";\n        wait;\n    end process;\nend architecture test;",
        "expectedOutput": "GHDL simulation works!"
      }
